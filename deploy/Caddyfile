{
	admin off
	servers {
		timeouts {
			read_header 10s
			read_body 25s
		}
	}
}

https://{$RAG_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	basic_auth {
		import /run/secrets/rag-users
	}

	@api_json {
		method POST
		path /api/v1/chat /api/v1/approvals /api/v1/query /api/v2/policy-revenue /api/v2/multisource /api/v2/policy-exploration /api/v2/policy-investigation /api/v3/investigations
	}
	request_body @api_json {
		max_size 16KiB
	}

	@policy_doc_upload {
		method POST
		path /api/v2/policy-documents /api/v2/policy-documents/*/versions /api/v3/manual-documents /api/v3/manual-documents/*/versions
	}
	request_body @policy_doc_upload {
		max_size 64KiB
	}

	@policy_acl {
		method PUT
		path /api/v2/policy-documents/*/readers /api/v3/manual-documents/*/readers
	}
	request_body @policy_acl {
		max_size 16KiB
	}

	@uploads path /api/v1/files /api/v1/files/preview /_stcore/upload_file/*
	request_body @uploads {
		max_size 11MiB
	}

	@api path /api/v1/* /api/v2/* /api/v3/*
	handle @api {
		reverse_proxy api:8000 {
			header_up -Authorization
			header_up X-Rag-User {http.auth.user.id}
			header_up X-Rag-Gateway-Key {$RAG_GATEWAY_KEY}
		}
	}

	handle {
		reverse_proxy ui:8501 {
			header_up -Authorization
			header_up X-Rag-User {http.auth.user.id}
			header_up X-Rag-Gateway-Key {$RAG_GATEWAY_KEY}
		}
	}
}
