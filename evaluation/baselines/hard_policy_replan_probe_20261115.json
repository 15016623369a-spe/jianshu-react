      "net_cents": 24640,
      "sql": "WITH selected_orders AS (\n  SELECT id, amount_cents, refund_cents\n  FROM orders\n  WHERE product = ? AND region = ? AND ordered_on >= ? AND ordered_on < ?\n),\nevents_per_order AS (\n  SELECT L.order_id, SUM(L.amount_cents) AS amount_cents\n  FROM chargebacks AS L JOIN selected_orders AS O ON L.order_id = O.id\n  GROUP BY L.order_id\n),\ndeductions AS (\n  SELECT selected_orders.amount_cents AS gross_cents, MIN(COALESCE(events_per_order.amount_cents, 0), ?) AS deducted_cents\n  FROM selected_orders LEFT JOIN events_per_order ON selected_orders.id = events_per_order.order_id\n)\nSELECT COUNT(*) AS order_count,\n       COALESCE(SUM(gross_cents), 0) AS gross_cents,\n       COALESCE(SUM(deducted_cents), 0) AS deducted_cents,\n       COALESCE(SUM(gross_cents - deducted_cents), 0) AS net_cents\nFROM deductions",
